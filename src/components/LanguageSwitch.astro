---
import { pageUrl, type PageDef } from '../site.config';
import { languages, ui, type Lang } from '../i18n';

interface Props {
  page: PageDef;
  lang: Lang;
}

const { page, lang } = Astro.props;
const others = languages.filter((l) => l !== lang);
---

{
  others.map((other) => (
    <a class="lang-switch" href={pageUrl(page, other)} hreflang={other} lang={other} aria-label={ui.otherLanguage[lang]}>
      {other}
    </a>
  ))
}

<style>
  .lang-switch {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--icon-border);
    border-radius: 100%;
    color: var(--icon);
    font-size: 0.7em;
    font-weight: 400;
    letter-spacing: 0.08rem;
    text-transform: uppercase;
    transition:
      transform 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }

  .lang-switch:hover {
    border-color: var(--icon-hover);
    color: var(--icon-hover);
    transform: translateY(-11.25%);
  }
</style>
