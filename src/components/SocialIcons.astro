---
import Icon from './Icon.astro';
import { site } from '../site.config';

interface Props {
  /** "end" sits on the right (page footer), "start" on the left (about page). */
  align?: 'start' | 'end';
}

const { align = 'end' } = Astro.props;
---

<ul class:list={['socials', align]}>
  {
    site.socials.map((social) => (
      <li>
        <a href={social.url} target="_blank" rel="noopener" aria-label={social.name}>
          <Icon name={social.icon} />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 1.25em;
  }

  .end {
    justify-content: flex-end;
  }

  .start {
    justify-content: flex-start;
    font-size: 1.125em;
  }

  a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2em;
    height: 2em;
    border: 1px solid var(--icon-border);
    border-radius: 100%;
    transition:
      transform 0.25s ease,
      border-color 0.25s ease;
  }

  a :global(svg) {
    width: 60%;
    height: 60%;
    fill: var(--icon);
    transition: fill 0.25s ease;
  }

  a:hover {
    border-color: var(--icon-hover);
    transform: translateY(-11.25%);
  }

  a:hover :global(svg) {
    fill: var(--icon-hover);
  }

  @media (max-width: 360px) {
    .socials {
      gap: 0.75rem;
    }
  }
</style>
