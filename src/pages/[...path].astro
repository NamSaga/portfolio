---
import Base from '../layouts/Base.astro';
import SectionFooter from '../components/SectionFooter.astro';
import Gallery from '../components/Gallery.astro';
import Project from '../components/Project.astro';
import { galleryArtworks } from '../lib/artworks';
import { projectsFor } from '../lib/projects';
import { pages, pageUrl, type PageDef } from '../site.config';
import { languages, type Lang } from '../i18n';

// One static page per entry in `pages` and per language.
export function getStaticPaths() {
  return languages.flatMap((lang) =>
    pages.map((page) => ({
      params: { path: pageUrl(page, lang).replace(/^\/|\/$/g, '') || undefined },
      props: { page, lang },
    })),
  );
}

interface Props {
  page: PageDef;
  lang: Lang;
}

const { page, lang } = Astro.props;
const projects = page.kind === 'projects' ? await projectsFor(page.id, lang) : [];
---

<Base page={page} lang={lang}>
  {
    page.kind === 'gallery' && (
      <Gallery
        artworks={galleryArtworks(page.id)}
        lang={lang}
        group={page.id}
        variant={page.id === 'home' ? 'stack' : 'rows'}
        eager={4}
      />
    )
  }
  {projects.map((project) => <Project project={project} lang={lang} />)}
  {page.kind !== 'about' && <SectionFooter />}
</Base>
